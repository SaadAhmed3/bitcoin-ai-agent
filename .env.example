# Copy this file to .env and adjust. Never commit .env.

APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false

# Order of market data providers (first healthy one wins). Options: binance, coinbase
MARKET_PROVIDERS=binance,coinbase

# Optional: free CoinGecko Demo API key (free registration, no card). Leave blank to use public limits.
COINGECKO_DEMO_API_KEY=

REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=2
PRICE_STALE_SECONDS=120
CANDLE_LIMIT=500

# News: minutes between RSS polls is NEWS_REFRESH_SECONDS / 60 (be polite to publishers)
NEWS_REFRESH_SECONDS=600

# Local AI assistant (Phase 7, optional, free). Install Ollama from https://ollama.com or:
#   winget install Ollama.Ollama   then   ollama pull qwen2.5:3b
# Keep OLLAMA_URL on localhost (127.0.0.1) so your data never leaves this computer.
# Without Ollama the assistant still works with deterministic rule-based answers.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=150
ASSISTANT_MAX_MESSAGE_CHARS=1000

# Global Intelligence (optional). A free FRED API key enables the S&P 500; without it the S&P 500 shows as unavailable.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html  Personal use only. It is never shown, logged or stored.
FRED_API_KEY=

# Global Intelligence (optional). Your contact address, sent only in the User-Agent of the SEC press-release feed, as the SEC
# asks of automated clients. Without it the SEC feed stays best-effort. It is never logged, stored or shown.
CALENDAR_CONTACT_EMAIL=

# Settings precedence (Phase 8): an env value here wins over the Settings page and shows there as read-only.
# DISPLAY_TIMEZONE=Asia/Karachi
